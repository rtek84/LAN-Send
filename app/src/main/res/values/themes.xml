<resources>
    <style name="Theme.PocketDrop" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pocket_blue</item>
        <item name="colorPrimaryVariant">@color/pocket_blue_dark</item>
        <item name="colorSecondary">@color/pocket_blue</item>
        <item name="materialButtonStyle">@style/PocketDrop.Button</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/pocket_surface</item>
        <item name="android:navigationBarColor">@color/pocket_surface</item>
    </style>

    <style name="PocketDrop.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">13dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="PocketDrop.SectionTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pocket_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
