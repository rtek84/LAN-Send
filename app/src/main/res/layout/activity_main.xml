<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/pocket_surface" android:clipToPadding="false" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp"
        android:paddingEnd="20dp" android:paddingBottom="36dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                android:contentDescription="LAN Send" android:src="@drawable/lan_send_logo" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LAN Send" android:textColor="@color/pocket_text"
                    android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp" android:text="Private transfers over local Wi-Fi"
                    android:textColor="@color/pocket_muted" android:textSize="13sp" />
            </LinearLayout>
            <Button android:id="@+id/settingsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp" android:layout_height="48dp"
                android:contentDescription="Settings" android:minWidth="0dp"
                android:padding="0dp" android:text="⚙" android:textAllCaps="false"
                android:textColor="@color/pocket_text_soft" android:textSize="23sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/pocket_card" app:cardCornerRadius="18dp" app:cardElevation="0dp"
            app:strokeColor="@color/pocket_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PocketDrop.SectionTitle" android:text="Connection" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Scan the QR code shown on your PC"
                    android:textColor="@color/pocket_muted" android:textSize="13sp" />
                <Button android:id="@+id/scanQr" android:layout_width="match_parent" android:layout_height="52dp"
                    android:layout_marginTop="15dp" android:text="Scan QR code" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="15dp" android:gravity="center" android:text="OR CONNECT MANUALLY"
                    android:textColor="@color/pocket_muted" android:textSize="11sp" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:hint="PC address">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/serverAddress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:hint="Private key">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/privateKey"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <Button android:id="@+id/saveConnection" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp"
                    android:text="Save connection" android:textAllCaps="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/pocket_success_surface" app:cardCornerRadius="18dp" app:cardElevation="0dp"
            app:strokeColor="@color/pocket_success_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="●  PHONE INBOX" android:textColor="@color/pocket_success"
                    android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/receivedFromPc" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="7dp"
                    android:text="Phone receiver active\nWaiting for something from your PC"
                    android:textColor="@color/pocket_success_text" android:textSize="15sp" android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/pocket_card" app:cardCornerRadius="18dp" app:cardElevation="0dp"
            app:strokeColor="@color/pocket_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PocketDrop.SectionTitle" android:text="Send to PC" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:hint="Message or link">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/messageText"
                        android:layout_width="match_parent" android:layout_height="96dp" android:gravity="top|start"
                        android:inputType="textMultiLine" android:paddingTop="14dp" />
                </com.google.android.material.textfield.TextInputLayout>
                <Button android:id="@+id/sendMessage" android:layout_width="match_parent" android:layout_height="50dp"
                    android:layout_marginTop="10dp" android:text="Send message" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="18dp" android:layout_marginBottom="16dp" android:background="@color/pocket_border" />
                <Button android:id="@+id/chooseFiles" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:text="Choose files or pictures" android:textAllCaps="false" />
                <TextView android:id="@+id/selectedFiles" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="No files selected" android:textColor="@color/pocket_muted" android:textSize="13sp" />
                <Button android:id="@+id/sendFiles" android:layout_width="match_parent" android:layout_height="50dp"
                    android:layout_marginTop="10dp" android:enabled="false" android:text="Send selected files" />
                <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:visibility="gone" />
                <TextView android:id="@+id/statusText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center"
                    android:text="Ready" android:textColor="@color/pocket_blue" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/pocket_card" app:cardCornerRadius="18dp" app:cardElevation="0dp"
            app:strokeColor="@color/pocket_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/PocketDrop.SectionTitle" android:text="Transfer activity" />
                <TextView android:id="@+id/transferActivity" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@color/pocket_activity_surface" android:minHeight="118dp" android:padding="14dp"
                    android:text="No transfers yet" android:textColor="@color/pocket_text_soft"
                    android:textSize="13sp" android:lineSpacingExtra="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
